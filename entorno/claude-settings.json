{
  "language": "Español",
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"~/.claude/statusline.ps1\""
  },
  "extraKnownMarketplaces": {},
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "prompt-mejorado@craft-mods": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/seguridad.mjs\" mensaje",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/titulo-sesion.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/craft-siempre.mjs\" mensaje",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/craft-siempre.mjs\" sesion",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/leo-indice.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/seguridad.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/git-guarda.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/apuntes-sesion.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/skills/craft/entorno/hooks/craft-siempre.mjs\" escrito",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "frontend-design": "off",
    "craft": "user-invocable-only",
    "llm-council": "name-only",
    "api-and-interface-design": "name-only",
    "observability-and-instrumentation": "name-only",
    "impeccable": "name-only",
    "trabajo-diario": "name-only",
    "security-audit": "name-only"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 300000
    }
  }
}
